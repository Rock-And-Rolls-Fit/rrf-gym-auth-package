{
  "name": "@rock-and-rolls-fit/rrf-gym-auth-package",
  "version": "1.2.0",
  "description": "Reusable authorization package for RockFit microservices using CASL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rock-and-rolls-fit/rrf-gym-auth-package.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "peerDependencies": {
    "@casl/ability": "^6.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  },
  "dependencies": {
    "keyv": "^5.0.0",
    "@keyv/redis": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
